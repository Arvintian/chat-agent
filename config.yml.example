# Model provider configuration
# Available fields per provider:
#   - type: provider type (openai, deepseek, claude, gemini, qwen, qianfan, ark, ollama, openrouter)
#   - baseUrl: API base URL
#   - apiKey: API key for authentication
#   - headers: custom HTTP headers to include in every request (optional)
#   - timeout: request timeout in seconds (optional)
#   - idleTimeout: HTTP client connection pool idle timeout in seconds
#     (optional, default 30)
providers:
  deepseek:
    type: deepseek
    baseUrl: https://api.deepseek.com
    apiKey: sk-secret-token
  # Example with custom headers:
  # my-openai:
  #   type: openai
  #   baseUrl: https://api.openai.com/v1
  #   apiKey: sk-secret-token
  #   headers:
  #     X-Custom-Header: custom-value

# Model configuration
# Two modes are supported:
# 1. Single provider - specify provider, model, and optional parameters:
#    model-name:
#      provider: <provider-name>
#      model: <model-id>
#      thinking: true/false
# 2. Mixed (weighted) - list multiple sub-models to select between them
#    on each generation call. Supports optional weight field for weighted
#    random selection. When weights are equal (or omitted), uses round-robin.
#    model-name:
#      mixed:
#        - provider: <provider-name>
#          model: <model-id>
#          weight: 3  # Higher weight = more likely to be selected (default: 1, 0 = never selected)
#          thinking: true/false
#        - provider: <other-provider>
#          model: <other-model-id>
#          weight: 1
#          thinking: true/false
models:
  deepseek-chat:
    provider: deepseek
    model: deepseek-chat
    temperature: 0.8
  deepseek-reasoner:
    provider: deepseek
    model: deepseek-reasoner
    temperature: 0.8
  # Example of a mixed (weighted) model:
  # my-mixed-model:
  #   mixed:
  #     - provider: deepseek
  #       model: deepseek-chat
  #       weight: 3  # 3x more likely to be selected
  #     - provider: openai
  #       model: gpt-4o
  #       weight: 1  # default weight when not specified
  #       thinking: true

# Chat preset configuration
# Available fields:
#   - model: model name to use
#   - desc: description of the chat preset
#   - system: system prompt for the assistant
#   - maxMessageRounds: number of message rounds to keep in context (default: 10)
#   - contextMode: how to handle window overflow when a new round starts
#     (default: compress)
#     - compress: the oldest rounds are summarized synchronously (the request
#       waits) and replaced by a single summary round, once the round count
#       exceeds maxMessageRounds
#     - truncate: no model call; the history sent to the model is hard-capped
#       at maxMessageRounds, oldest rounds dropped first
#     - window: token-driven overflow, independent of maxMessageRounds. The
#       context size is measured from the prompt tokens the model reports for
#       each call; once it reaches contextCompressRatio of maxContextTokens,
#       the oldest rounds are summarized (like compress). Use this for models
#       with large windows where a single verbose round (e.g. big tool output)
#       can exhaust the context. Requires maxContextTokens to be set.
#   - maxContextTokens: model context window size in tokens (window mode)
#   - contextCompressRatio: fraction of the window that triggers compression
#     (window mode, default: 0.8)
#   - maxIterations: maximum iterations for tool calling (default: 20)
#   - maxRetries: maximum retries for model generation (default: 5)
#   - mcpServers: list of MCP servers to use
#   - tools: list of built-in tools to use (see tools section below)
#   - persistence: whether to persist conversation context (default: false)
#   - skill: skill configuration
#   - hooks: session hooks configuration
#   - cron: list of scheduled tasks (runs while the server is up)
#   - default: whether this is the default chat preset
#
# cron task configuration (list items under a chat's "cron:"):
#   A list of scheduled tasks. When a task's cron expression fires (5-field
#   format: minute hour day-of-month month day-of-week), the task runs on a
#   dedicated session named "cron":
#   1. the task hook (same shape as session hooks: type script/http,
#      scriptPath/url, timeout, env, ...) is executed first; its output MUST
#      be a JSON object
#   2. the task prompt is rendered as a Go template with the hook's JSON data
#      (e.g. {{.task}}, {{.items}}; built-ins .Date/.User/.Cwd/.Home also work)
#   3. the rendered prompt is sent to the agent as the user message to
#      execute the scheduled task
#   Example (script hook):
#     cron:
#       - expr: "* * * * *"
#         prompt: |
#           Execute the scheduled task: {{.task}}
#         hook:
#           enabled: true
#           type: script
#           scriptPath: ./cron-task.sh   # relative to ~/.chat-agent/hooks
#           timeout: 30
#   Example (http hook — session data is POSTed as a JSON request body, and
#   the response body must be a JSON object):
#     cron:
#       - expr: "0 */6 * * *"
#         prompt: |
#           Execute the scheduled task: {{.task}}
#         hook:
#           enabled: true
#           type: http
#           url: http://localhost:9000/cron-task
#           method: POST
#           headers:
#             Authorization: "Bearer your-token"
#           timeout: 30
#
# tools section configuration (top-level "tools:"):
#   A dictionary mapping tool name to tool definition. Chats reference tools by
#   name via the chat's "tools" list.
#   Each tool definition can have:
#   - category: tool category ("filesystem", "cmd", "smart_cmd")
#   - params: a dictionary of tool parameters (keys depend on category):
#       - workDir: working directory (required for filesystem and cmd tools)
#       - exclude: list of tool names to exclude (optional, for filesystem category)
#         Example filesystem tools that can be excluded: read_file, write_file, list_directory, etc.
#       - timeout: command timeout in seconds (optional, for cmd/smart_cmd, default 5)
#       - env: dictionary of environment variables applied to every executed
#         command (optional, for cmd/smart_cmd). Overrides the corresponding
#         process environment variables.
#   - autoApproval: whether to auto-approve tool calls (default: false)
#   - autoApprovalTools: list of specific tool names to auto-approve
#   Example:
# tools:
#   shell:
#     category: cmd
#     params:
#       workDir: /home/user
#       timeout: 30
#       env:
#         http_proxy: http://127.0.0.1:7890
#         https_proxy: http://127.0.0.1:7890
chats:
  default:
    model: deepseek-chat
    desc: "A friendly assistant"
    system: "You are a helpful search assistant."
    # persistence: false  # Default: disabled, set to true to enable context persistence
  
  temp-chat:
    model: deepseek-chat
    desc: "Temporary chat without persistence"
    system: "You are a helpful search assistant."
    # persistence: false  # Explicitly disabled (same as default)
  
  persistent-chat:
    model: deepseek-chat
    desc: "Chat with history persistence enabled"
    system: "You are a helpful assistant with memory."
    persistence: true  # Enable persistence for this chat
  default-mcp:
    model: deepseek-chat
    desc: "A friendly assistant"
    system: "You are a helpful search assistant."
    mcpServers:
      - web_search
  reasoner:
    model: deepseek-reasoner
    desc: "A friendly assistant"
    system: "You are a helpful search assistant."
  reasoner-mcp:
    model: deepseek-reasoner
    desc: "A friendly assistant"
    system: "You are a helpful search assistant."
    mcpServers:
      - web_search
  template-example:
    model: deepseek-chat
    desc: "Assistant with template variables"
    system: |
      You are a helpful assistant.
      
      Context information:
      - Current working directory: {{.Cwd}}
      - Today's date: {{.Date}}
      - Username: {{.User}}
      - Home directory: {{.Home}}
      - Environment USER: {{env "USER"}}
      
      Please help the user with tasks in the current directory.

  cron-example:
    model: deepseek-chat
    desc: "Chat with a scheduled task"
    system: "You are a scheduled task executor."
    # note: cron runs are always non-persistent, regardless of "persistence"
    cron:
      - expr: "0 9 * * *"   # every day at 09:00
        prompt: |
          Execute the scheduled task: {{.task}}
        hook:
          enabled: true
          type: script
          scriptPath: ./cron-task.sh
          timeout: 30
        # the hook above must print a JSON object to stdout, e.g.:
        # {"task": "summarize today's news"}
      - expr: "0 */6 * * *"  # every 6 hours
        prompt: |
          Execute the scheduled task: {{.task}}
        hook:
          enabled: true
          type: http
          url: http://localhost:9000/cron-task
          method: POST
          headers:
            Authorization: "Bearer your-token"
          timeout: 30
        # the endpoint above must respond with a JSON object, e.g.:
        # {"task": "check disk usage and report if over 90%"}

# MCP server configuration
# Available fields per MCP server:
#   - type: connection type ("stdio", "sse", "streamable-http")
#   - cmd: command for stdio transport (required for stdio type)
#   - args: arguments for stdio command
#   - env: environment variables for stdio command
#   - url: server URL for sse/streamable-http (required for sse/streamable-http types)
#   - headers: HTTP headers for sse/streamable-http
#   - autoApproval: whether to auto-approve all tool calls from this server (default: false)
#   - autoApprovalTools: list of specific tool names to auto-approve
#   - include: list of tool names to include (if set, only these tools are enabled)
#   - exclude: list of tool names to exclude (if set, these tools are removed)
#   - noConcurrent: boolean, if true all tools from this server are serialized (mutex per server)
#   - noConcurrentTools: list of tool names that should NOT be called concurrently
#     (use this for tools that don't support parallel calls, each tool gets its own mutex)
mcpServers:
  web_search:
    type: sse
    url: "https://your-mcp-host"
    # autoApproval: true
    # include:
    #   - search
    #   - fetch
    # exclude:
    #   - some_slow_tool
    #   - some_dangerous_tool
